[Unit]
Description=MIDI patch display bridge (FluidSynth -> CYD)
After=sound.target
Wants=sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/midi-patch-display/pi
ExecStart=/usr/bin/python3 /home/pi/midi-patch-display/pi/bridge.py \
    --port /dev/midi-panel \
    --midi-in "" \
    --battery none
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
