[Unit]
Description=VHS-1 first-boot panel (Wi-Fi picker until setup finishes)
ConditionPathExists=!/var/lib/vhs/provisioned
Conflicts=patchbridge.service
After=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/vhs/VirtualHardSynth/midi-patch-display/pi/netsetup.py \
    --port /dev/serial0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
