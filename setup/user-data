#cloud-config
# VHS-1 first boot, copied to the card's boot partition by prepare-card.ps1.
#
# The user isn't created here: Raspberry Pi OS ships a placeholder first
# user and renames it from userconf.txt (also written by prepare-card.ps1),
# or else stops boot at an interactive "enter new username" dialog.
# cloud-init's users module never runs on this image. firstboot.sh installs
# the SSH key and sudo rule instead.
hostname: vhs
manage_etc_hosts: true
keyboard:
  layout: us
ssh_pwauth: false
enable_ssh: true
runcmd:
  - [bash, /boot/firmware/vhs/VirtualHardSynth/setup/firstboot.sh]
