[Unit]
Description=VirtualHardSynth patch table web UI
After=network.target

[Service]
Type=simple
User=vhs
WorkingDirectory=/home/vhs/VirtualHardSynth/synth
ExecStart=/usr/bin/python3 /home/vhs/VirtualHardSynth/synth/webui.py --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
