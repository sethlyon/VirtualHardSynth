[Unit]
Description=FluidSynth software synthesizer (VirtualHardSynth engine)
After=sound.target
Wants=sound.target

[Service]
Type=simple
User=vhs
ExecStart=/usr/bin/fluidsynth -s -i -a alsa \
    -o audio.alsa.device=hw:CARD=wm8960soundcard \
    -o midi.autoconnect=1 \
    -o audio.period-size=64 \
    -o audio.periods=4 \
    /usr/share/sounds/sf2/FluidR3_GM.sf2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
